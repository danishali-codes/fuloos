{
  "name": "fuloos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:pb": "node --experimental-strip-types scripts/pb-test.ts",
    "check:live": "node --experimental-strip-types scripts/live-auth-check.ts",
    "build:sms-engine": "node scripts/build-sms-engine.mjs",
    "mobile:sync": "npm run build && npm run build:sms-engine && npx cap sync",
    "mobile:android": "npm run build && npm run build:sms-engine && npx cap sync android",
    "mobile:ios": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-react": "1.72.0",
    "pdfjs-dist": "6.5.438",
    "pocketbase": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "vite": "8.3.8"
  }
}
