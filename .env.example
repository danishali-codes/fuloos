# Backend selector: "pocketbase" (default) or "supabase".
VITE_BACKEND=pocketbase

# PocketBase (used when VITE_BACKEND is omitted or "pocketbase").
# Set only after installing pocketbase/pb_migrations on your server.
# Public URL only — no admin or superuser credentials belong in the frontend.
VITE_POCKETBASE_URL=
# Example: https://pb.danishali.dev

# Supabase (used when VITE_BACKEND=supabase).
# Public project URL and anon/publishable key only — never put service_role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Example: https://<project-ref>.supabase.co

# Optional: stable inbound capture webhook URL displayed in Captured Alerts setup
# (e.g. https://fuloos.danishali.dev/api/inbound-email).
VITE_CAPTURE_WEBHOOK_URL=

# Optional: URL of the hashed Ledger categoriser model (made with scripts/ledger/hash-model.ts).
# Host it outside this repository. Without it, SMS import uses brand and keyword rules only.
VITE_LEDGER_MODEL_URL=

# Optional: Web Push VAPID public key (base64url).
VITE_VAPID_PUBLIC_KEY=
